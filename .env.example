# --- OpenAI ---
OPENAI_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:5173

# --- Agent / performance guardrails ---
MAX_BROWSER_CONCURRENCY=2
MAX_RUNS_PER_USER=5
RUN_COOLDOWN_SECONDS=30
AI_CONTEXT_TOKEN_BUDGET=6000
PAGE_CAPTURE_TIMEOUT_MS=30000
MAX_SCROLL_DURATION_MS=15000
MAX_SCROLL_STEPS=25
AI_RETRY_COUNT=1
AI_RETRY_DELAY_MS=1000

# --- Demo auth (optional — run `npm run seed:demo-user --workspace apps/server`) ---
DEMO_USER_EMAIL=demo@changescope.dev
DEMO_USER_PASSWORD=   # 8+ characters

# Note: the frontend needs its own env file for Supabase Auth to work in the
# browser — see apps/web/.env.example (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).
